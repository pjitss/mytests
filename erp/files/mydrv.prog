#!/bin/ksh

TIME_STAMP=`date +%Y%m%d.%H%M`

. /u01/app/oracle/EBSapps.env RUN

LOGFILE="$XXEBG_TOP/install/MVP4/MVP4DBDRV.log"; export LOGFILE
if [ $LOGFILE ]
then rm -f $LOGFILE
fi

export DB_USRNM=APPS/$apps_passwd@ENEMPDB

echo " "
echo "Start of Log File"
echo "--------------------------------------------------------------" | tee -a $LOGFILE
echo "Creating Database Objects..."

echo "------------------------------Alert---------------------------" | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $ALR_TOP/patch/115/import/alr.lct $XXEBG_TOP/install/MVP4/XXEBG_CLARITY_CONC_PGM_NOTIFICATION.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE

echo "------------------------------Value Set-----------------------" | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afffload.lct $XXEBG_TOP/install/MVP4/XXEBG_EMP_PM_DM.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afffload.lct $XXEBG_TOP/install/MVP4/XXEBG_CLARITY_PPM_PRJ.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afffload.lct $XXEBG_TOP/install/MVP4/XXEBG_CLARITY_PPM_PRJ_CAT.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE

echo "------------------------------Tables--------------------------" | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_SUPP_EXT_T.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_SUPP_HIS_T.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_PPM_PRJ_MAS_T.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_PPM_PR_STG.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_REP_HITS_T.sql | tee -a $LOGFILE

echo "------------------------------Sequence------------------------" | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_COST_REPORT_BKP_S.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_COST_REPORT_S.sql | tee -a $LOGFILE

echo "------------------------------View----------------------------" | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/APPS.XXEBG_CR_DET.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CR_DET.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_PPM_PRJ_MAS_V.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_PPM_PRJ_V.sql | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/XXEBG_CLARITY_PPM_PRJ_TMP_V.sql | tee -a $LOGFILE

echo "------------------------------Functions-----------------------" | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/GET_EMAIL_ADDRESS.fnc | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/GET_GL_ACCOUNT.fnc | tee -a $LOGFILE

echo "------------------------------Packages------------------------" | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/APPS.XXEBG_CLARITY_PPM_PR_PKG.pks | tee -a $LOGFILE
sqlplus -s $DB_USRNM @$XXEBG_TOP/install/MVP4/APPS.XXEBG_CLARITY_PPM_PR_PKG.pkb | tee -a $LOGFILE

echo "------------------------------Concurrent Program------------------------" | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afcprog.lct $XXEBG_TOP/install/MVP4/XXEBG_CLARITY_SUPP_EXTRACT.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afcprog.lct $XXEBG_TOP/install/MVP4/XXEBG_CLARITY_SUPP_PKGS_KSH.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afcprog.lct $XXEBG_TOP/install/MVP4/XXEBG_CLARITY_SUPP_MJFS_KSH.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afcprog.lct $XXEBG_TOP/install/MVP4/XXEBG_CLARITY_SUPP_ALMDS_KSH.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afcprog.lct $XXEBG_TOP/install/MVP4/XXEBG_CLARITY_SUPP_LKBFA_KSH.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE

echo "------------------------------Copy Prog file-----------------------------" | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_extract_ksh.prog /u01/app/oracle/fs2/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_extract_ksh.prog /u01/app/oracle/fs1/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_YHM_PYG.prog /u01/app/oracle/fs2/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_YHM_PYG.prog /u01/app/oracle/fs1/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_ASXF_PLK.prog /u01/app/oracle/fs2/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_ASXF_PLK.prog /u01/app/oracle/fs1/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_LOPL_sh.prog /u01/app/oracle/fs2/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_LOPL_sh.prog /u01/app/oracle/fs1/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_KINDS_PY.prog /u01/app/oracle/fs2/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_KINDS_PY.prog /u01/app/oracle/fs1/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE

echo "------------------------------ctl file----------------------------------" | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_prj_master_det.ctl /u01/app/oracle/fs2/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_prj_master_det.ctl /u01/app/oracle/fs1/EBSapps/appl/xxebg/12.0.0/bin/ | tee -a $LOGFILE

echo "------------------------------sql Script File----------------------------" | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_supp_extract.sql /empower_ctm_tasks/ctm/sql/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/xxebg_clarity_pr_reponse_file.sql /empower_ctm_tasks/ctm/sql/ | tee -a $LOGFILE

echo "------------------------------Request Set--------------------------------" | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afcprset.lct PR_ATTACH.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE
$FND_TOP/bin/FNDLOAD $DB_USRNM 0 Y UPLOAD $FND_TOP/patch/115/import/afcprset.lct PR_ATTACH_LINK.ldt WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE | tee -a $LOGFILE

echo "------------------------------OAF VO File--------------------------------" | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/XxebgPODetailsVO.xml /u01/app/oracle/fs2/EBSapps/comn/java/classes/xxebg/oracle/apps/xxebg/inv/invdigitization/server/ | tee -a $LOGFILE
cp -r $XXEBG_TOP/install/MVP4/XxebgPODetailsVO.xml /u01/app/oracle/fs1/EBSapps/comn/java/classes/xxebg/oracle/apps/xxebg/inv/invdigitization/server/ | tee -a $LOGFILE

echo "------------------------------end----------------------------------------" | tee -a $LOGFILE
echo "Completed Installation...." | tee -a $LOGFILE
echo "Completed Installation" | tee -a $LOGFILE
echo "End of Logfile"