#!/bin/ksh

TIME_STAMP=`date +%Y%m%d.%H%M`


. /u01/app/oracle/EBSapps.env RUN

LOGFILE="MVP4DBDRV.log"; export LOGFILE

echo " "
echo "Start of Log File"
echo "--------------------------------------------------------------" | tee -a $LOGFILE
echo "Creating Database Objects..."

echo "------------------------------Alert---------------------------" | tee -a $LOGFILE
[FNDLOAD_ALERT]
lct=alr.lct
args=WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE
XXEBG_CLARITY_CONC_PGM_NOTIFICATION.ldt
[/FNDLOAD_ALERT]

echo "------------------------------Value Set-----------------------" | tee -a $LOGFILE
[FNDLOAD_VALUESET]
lct=afffload.lct
args=WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE
XXEBG_EMP_PM_DM.ldt
XXEBG_CLARITY_PPM_PRJ.ldt
XXEBG_CLARITY_PPM_PRJ_CAT.ldt
[/FNDLOAD_VALUESET]

echo "------------------------------Tables--------------------------" | tee -a $LOGFILE
[SQL_TABLES]
XXEBG_CLARITY_SUPP_EXT_T.sql
XXEBG_CLARITY_SUPP_HIS_T.sql
XXEBG_CLARITY_PPM_PRJ_MAS_T.sql
XXEBG_CLARITY_PPM_PR_STG.sql
XXEBG_CLARITY_REP_HITS_T.sql
[/SQL_TABLES]

echo "------------------------------Sequence------------------------" | tee -a $LOGFILE
[SQL_SEQUENCES]
XXEBG_CLARITY_COST_REPORT_BKP_S.sql
XXEBG_CLARITY_COST_REPORT_S.sql
[/SQL_SEQUENCES]

echo "------------------------------View----------------------------" | tee -a $LOGFILE
[SQL_VIEWS]
APPS.XXEBG_CR_DET.sql
XXEBG_CR_DET.sql
XXEBG_CLARITY_PPM_PRJ_MAS_V.sql
XXEBG_CLARITY_PPM_PRJ_V.sql
XXEBG_CLARITY_PPM_PRJ_TMP_V.sql
[/SQL_VIEWS]

echo "------------------------------Functions-----------------------" | tee -a $LOGFILE
[SQL_FUNCTIONS]
GET_EMAIL_ADDRESS.fnc
GET_GL_ACCOUNT.fnc
[/SQL_FUNCTIONS]

echo "------------------------------Packages------------------------" | tee -a $LOGFILE
[SQL_PACKAGES_SPEC]
APPS.XXEBG_CLARITY_PPM_PR_PKG.pks
[/SQL_PACKAGES_SPEC]

[SQL_PACKAGES_BODY]
APPS.XXEBG_CLARITY_PPM_PR_PKG.pkb
[/SQL_PACKAGES_BODY]

echo "------------------------------Concurrent Program------------------------" | tee -a $LOGFILE
[FNDLOAD_CONCURRENT_PROGRAM]
lct=afcprog.lct
args=WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE
XXEBG_CLARITY_SUPP_EXTRACT.ldt
XXEBG_CLARITY_SUPP_PKGS_KSH.ldt
XXEBG_CLARITY_SUPP_MJFS_KSH.ldt
XXEBG_CLARITY_SUPP_ALMDS_KSH.ldt
XXEBG_CLARITY_SUPP_LKBFA_KSH.ldt
[/FNDLOAD_CONCURRENT_PROGRAM]

echo "------------------------------Copy Prog file-----------------------------" | tee -a $LOGFILE
[Prog_File_Copy]
dest=/u01/app/oracle/fs2/EBSapps/appl/xxebg/12.0.0/bin/
dest=/u01/app/oracle/fs1/EBSapps/appl/xxebg/12.0.0/bin/
src=xxebg_clarity_supp_extract_ksh.prog
src=xxebg_clarity_supp_YHM_PYG.prog
src=xxebg_clarity_supp_ASXF_PLK.prog
src=xxebg_clarity_supp_LOPL_sh.prog
src=xxebg_clarity_supp_KINDS_PY.prog
[/Prog_File_Copy]

echo "------------------------------ctl file----------------------------------" | tee -a $LOGFILE
[CTL_File_Copy]
dest=/u01/app/oracle/fs2/EBSapps/appl/xxebg/12.0.0/bin/
dest=/u01/app/oracle/fs1/EBSapps/appl/xxebg/12.0.0/bin/
src=xxebg_clarity_prj_master_det.ctl
[/CTL_File_Copy]

echo "------------------------------sql Script File----------------------------" | tee -a $LOGFILE
[CTM_SQL_Copy]
dest=/empower_ctm_tasks/ctm/sql/
src=xxebg_clarity_supp_extract.sql
src=xxebg_clarity_pr_reponse_file.sql
[/CTM_SQL_Copy]

echo "------------------------------Request Set--------------------------------" | tee -a $LOGFILE
[FNDLOAD_REQUEST_SET]
lct=afcprset.lct
args=WARNING=YES UPLOAD_MODE=REPLACE CUSTOM_MODE=FORCE
PR_ATTACH.ldt
PR_ATTACH_LINK.ldt
[/FNDLOAD_REQUEST_SET]

echo "------------------------------OAF VO File--------------------------------" | tee -a $LOGFILE
[OAF_VO_Copy]
dest=/u01/app/oracle/fs2/EBSapps/comn/java/classes/xxebg/oracle/apps/xxebg/inv/invdigitization/server/
dest=/u01/app/oracle/fs1/EBSapps/comn/java/classes/xxebg/oracle/apps/xxebg/inv/invdigitization/server/
src=XxebgPODetailsVO.xml
[/OAF_VO_Copy]

echo "------------------------------end----------------------------------------" | tee -a $LOGFILE
echo "Completed Installation...." | tee -a $LOGFILE
echo "Completed Installation" | tee -a $LOGFILE
echo "End of Logfile"