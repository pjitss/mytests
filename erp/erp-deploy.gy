node {

    cleanWs()

    stage('git repo checkout') {
        git branch: 'jits_1', url: 'git@github.com:pjitss/mytests.git'
    }

    if (TASK == "upload") {
        stage('Execute upload job') {
            ansiblePlaybook(
                playbook: "epm/tasks/epm_upload.yml",
                inventory: "epm/env/${ENVNAME}/${ENVNAME}.inv",
                extraVars: [
                    ENVNAME : "${ENVNAME}",
                    TASK    : "${TASK}"
                ]
            )
        }
    }

    if (TASK == "download") {
        stage('Execute download job') {
            ansiblePlaybook(
                playbook: "erp/tasks/main.yml",
                inventory: "erp/env/${ENVNAME}/${ENVNAME}.inv",
                extraVars: [
                    ENVNAME : "${ENVNAME}",
                    TASK    : "${TASK}",
                    FILENAME: "${FILENAME}"
                ]
            )
        }
    }


    if (TASK == "deploy") {
        stage('Execute deploy job') {
            ansiblePlaybook(
                playbook: "erp/tasks/main.yml",
                extras: "-vv -i erp/env/${ENVNAME}/${ENVNAME}.inv -e ENVNAME=${ENVNAME} -e TASK=${TASK} -e FILENAME=${FILENAME}"
            )
        }
    }
}
